# Sentinel-01, hand-written in AET-WO-4400 as the generator would then emit it. Its first lines
# came from the topology of specification sha256 a277c933439524885deb931b2b930555b74aa94aefbee7b34c83ddef73aa1196
# (examples/sentinel-01-minimal.json as of d00c9653, AET-WO-4100); that file has moved on since.
# SERIAL_ORDER and the USART3 lines came with AET-WO-4400a (47a883b8); the console's USART1
# lines, and USART1 first in SERIAL_ORDER, were added in AET-WO-4300b (25640c55). The SWD lines,
# PA13 and PA14, came with AET-WO-4410 (3): ArduPilot's own text, with the pull it gives each label.
# CI judges this board against the topology solved from examples/sentinel-01-minimal.json at
# the commit under test (.github/workflows/ardupilot-image.yml, job pinout): by path, never by
# a hash, which would go stale at every specification bump.
# Tags, per line, are the spike's and are not kept current: [T] emitted from the SolvedTopology
# then; [S] in the Specification only (RUL-16 forbids reading it there); [N] in neither.

MCU STM32H7xx STM32H753xx      # [S] mcu.part STM32H753ZITx; series and table name are a mapping
OSCILLATOR_HZ 8000000          # [N] no oscillator declared; the solver only reserves PH0/PH1
FLASH_SIZE_KB 2048             # [N] a part fact (DS12117), not in any table we hold
APJ_BOARD_ID 7777              # [N] a registry number; numeric accepted off CI
define AP_BOOTLOADER_FLASHING_ENABLED 0   # [N] step B: no bootloader binary to embed

I2C_ORDER I2C1                 # [T] i2c_devices[*].peripheral, one bus
PB6 I2C1_SCL I2C1              # [T] assignments.I2C_SCL
PB7 I2C1_SDA I2C1              # [T] assignments.I2C_SDA

PA5 SPI1_SCK SPI1              # [T] assignments.SPI_SCK
PA6 SPI1_MISO SPI1             # [T] assignments.SPI_MISO
PA7 SPI1_MOSI SPI1             # [T] assignments.SPI_MOSI
PA0 FLASH_CS CS                # [T] gpio.FLASH_CS (label = net)

SPIDEV dataflash SPI1 DEVID1 FLASH_CS MODE3 20*MHZ 20*MHZ  # [T] bus, cs; [S] speed 20 MHz; [N] mode, role name
define HAL_LOGGING_DATAFLASH_ENABLED 1                     # [N] role of part W25Q64JV (a parts-table fact)

BARO BMP280 I2C:0:0x76         # [T] U2 part BME280 -> driver BMP280 (a mapping), I2C_ORDER index 0, address 118
SERIAL_ORDER USART1 USART3     # [T] serial_ports.CONSOLE.peripheral first (AET-WO-4300b); USART3 [N], kept for the allow list
PA9 USART1_TX USART1           # [T] assignments.CONSOLE_TX (AET-WO-4300b)
PA10 USART1_RX USART1          # [T] assignments.CONSOLE_RX (AET-WO-4300b)
PD8 USART3_TX USART3           # [N] step F: a UART the topology lacks, allowed by step-g.allow.json
PD9 USART3_RX USART3           # [N] step F
define HAL_USE_ADC FALSE       # [N] step C: no ADC pin in the topology (4300d)
define HAL_STORAGE_SIZE 16384  # [N] step D: parameter storage size, no source
FLASH_RESERVE_START_KB 0       # [N] step G: no bootloader, so the image must start at 0x08000000
PA13 JTMS-SWDIO SWD PULLUP     # [N] AET-WO-4410 (3): SWD kept on, alternate AF0
PA14 JTCK-SWCLK SWD PULLDOWN   # [N] AET-WO-4410 (3)
