        "PUPD9",
        "PUPD10",
        "PUPD11",
        "PUPD12",
        "PUPD13",
        "PUPD14",
        "PUPD15"
      ],
      "reason": "No pull is modelled. Written whole by split: no internal pull on PB6/PB7 (the bus has 2.2 kOhm), PB4's reset pull-up kept. The bench row reads PUPDR back."
    },
    {
      "register": "I2C1.CR1",
      "class": "same-source",
      "fields": [
        "PE"
      ],
      "reason": "PE is set by the enable, not by silicon::i2c_cr1 (whose word has PE clear); stored, with no reaction claimed. The bench row reads PE as 1; the bus records on the bench need it."
    },
    {
      "register": "I2C1.CR2",
      "class": "same-source",
      "fields": [
        "ADD10",
        "HEAD10R",
        "STOP",
        "NACK",
        "RELOAD",
        "AUTOEND",
        "PECBYTE"
      ],
      "reason": "7-bit addressing, no reload, no PEC, written 0 (AUTOEND set at run time): STM32F7_I2C.cs is not held, no reaction claimed. The bench row reads CR2 back, all but AUTOEND."
    },
    {
      "register": "I2C1.ICR",
      "class": "same-source",
      "fields": [
        "ADDRCF",
        "NACKCF",
        "STOPCF",
        "BERRCF",
        "ARLOCF",
        "OVRCF",
        "PECCF",
        "TIMOUTCF",
        "ALERTCF"
      ],
      "reason": "Write-1-to-clear (RM0433 Rev 9 section 47.9.8, p. 2015), so no bench row: STOPCF and NACKCF after each transfer. The next record's OK status on the bench (3302 B3) shows the clear took."
    },
    {
      "register": "RCC.CR",
      "class": "ignored-by-model",
      "fields": [
        "D2CKRDY"
      ],
      "reason": "Not polled (ruling on Q-F): STM32H7_RCC.cs L175 keeps it a tag reading 0, so a wait would park every boot. Silicon must read 1 after a D2 enable: a bench row (3302)."
    },
    {
      "register": "RCC.D1CCIPR",
      "class": "ignored-by-model",
      "fields": [
        "CKPERSEL"
      ],
      "reason": "A tag in Renode (STM32H7_RCC.cs L401, read 0 whatever is written, 4230 FEEDBACK section 2). SPI1's kernel per_ck assumes HSI here; the bench row reads it, as 3302 B8."
    },
    {
      "register": "RCC.D2CCIP1R",
      "class": "ignored-by-model",
      "fields": [
        "SPI123SEL",
        "SPI45SEL"
      ],
      "reason": "ResetClock reads them at reset before the select write; a tag (STM32H7_RCC.cs L408-410) reads 0 whatever silicon holds. The written SPI123SEL is judged by spi_words."
    },
    {
      "register": "RCC.D2CCIP2R",
      "class": "ignored-by-model",
      "fields": [
        "USART16SEL",
        "USART28SEL",
        "I2C123SEL"
      ],
      "reason": "Left at reset (rcc_pclk2/pclk1 kernels the BRR and TIMINGR rules assume); a tag (STM32H7_RCC.cs L420-425) reads 0 whatever silicon holds. The bench row reads each."
    },
    {
      "register": "SCB.CPACR",
      "class": "same-source",
      "fields": [
        "CP10",
        "CP11"
      ],
      "reason": "The FPU enable in the generated Reset, outside every Kani harness; whether Renode faults a float with CPACR clear is not held. The bench row reads CP10/CP11 as full access."
    },
    {
      "register": "SPI1.CR2",
      "class": "ignored-by-model",
      "fields": [
        "TSER"
      ],
      "reason": "A tag (STM32H7_SPI.cs L149), written 0 with TSIZE: no reload is used. The bench row reads it back as 0."
    },
    {
      "register": "SPI1.IFCR",
      "class": "ignored-by-model",
      "fields": [
        "TXTFC",
        "UDRC",
        "OVRC",
        "CRCEC",
        "TIFREC",
        "MODFC",
        "TSERFC"
      ],
      "reason": "Tags in Renode (STM32H7_SPI.cs L258-266), written 0 beside EOTC; write-only, so no bench row. The boot record's flash identity, read on silicon, shows each transfer ended."
    },
    {
      "register": "SPI1.SR",
      "class": "ignored-by-model",
      "fields": [
        "MODF"
      ],
      "reason": "MODF is a tag (STM32H7_SPI.cs L238) and MASTER always reads 1: no mode fault in the twin. SSM|SSI before SPE is proved by Kani; the bench row reads MODF as 0 (3302 saw it 1)."
    },
    {
      "register": "USART1.CR1",
      "class": "ignored-by-model",
      "fields": [
        "UESM",
        "IDLEIE",
        "WAKE",
        "M0",
        "MME",
        "CMIE",
        "DEDT",
        "DEAT",
        "EOBIE",
        "M1",
        "FIFOEN",
        "TXFEIE",
        "RXFFIE"
      ],
      "reason": "Not stored by Renode's USART (4300b FEEDBACK section 0; M0, M1 measured P4.1): 8 data bits, FIFO off, no wake-up, interrupts off. The bench row reads CR1 back."
    },
    {
      "register": "USART1.CR1",
      "class": "same-source",
      "fields": [
        "RXNEIE_RXFNEIE",
        "TCIE",
        "TXEIE_TXFNFIE",
        "PEIE",
        "PS",
        "PCE",
        "OVER8",
        "RTOIE"
      ],
      "reason": "Stored with no reaction claimed (4300b FEEDBACK section 0): no parity, oversampling by 16, interrupts off, compared with the topology only. The bench row reads CR1 back."
    },
    {
      "register": "USART1.CR2",
      "class": "ignored-by-model",
      "fields": [
        "SLVEN",
        "DIS_NSS",
        "ADDM7",
        "LBDL",
        "LBDIE",
        "LBCL",
        "CPHA",
        "CPOL",
        "CLKEN",
        "LINEN",
        "SWAP",
        "RXINV",
        "TXINV",
        "DATAINV",
        "MSBFIRST",
        "ABREN",
        "ABRMODE",
        "RTOEN",
        "ADD"
      ],
      "reason": "STOP is the only CR2 field Renode stores (4300b FEEDBACK section 0; RXINV, TXINV measured P4.1): asynchronous, no swap, no inversion, LSB first. The bench row reads CR2 back."
    },
    {
      "register": "USART1.CR2",
      "class": "same-source",
      "fields": [
        "STOP"
      ],
      "reason": "One stop bit: stored, no reaction claimed (4300b FEEDBACK section 0), compared with the topology only. The bench row reads CR2.STOP back as 00."
    }
