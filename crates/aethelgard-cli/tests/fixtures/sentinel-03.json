        "OT8",
        "OT9",
        "OT10",
        "OT11",
        "OT12",
        "OT13",
        "OT14",
        "OT15"
      ],
      "reason": "OTYPER is not stored by Renode (4300b FEEDBACK section 10, measured): written whole, push-pull on every port A pin. The bench row reads it back, as 3302 B2 asked for GPIOB."
    },
    {
      "register": "GPIOA.PUPDR",
      "class": "same-source",
      "fields": [
        "PUPD0",
        "PUPD1",
        "PUPD2",
        "PUPD3",
