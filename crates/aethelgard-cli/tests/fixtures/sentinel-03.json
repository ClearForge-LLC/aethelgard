        "PUPD5",
        "PUPD6",
        "PUPD7",
        "PUPD9",
        "PUPD10",
        "PUPD12",
        "PUPD13",
        "PUPD14",
        "PUPD15"
      ],
      "reason": "No pull is modelled. Written whole by split: no pull on the solved pins, the debug pins' reset pulls (PA13 up, PA14 down, PA15 up) kept. The bench row reads PUPDR back."
    },
    {
      "register": "GPIOB.AFRL",
      "class": "same-source",
      "fields": [
        "AFSEL6",
        "AFSEL7"
      ],
      "reason": "PB6/PB7 at AF4 for I2C1: the model routes a pin by AFR only for a timer channel (4300 FEEDBACK section 0). The bench row reads AFRL back; 3302 B2 predicted 0x44 there."
    },
    {
      "register": "GPIOB.MODER",
      "class": "same-source",
      "fields": [
        "MODER6",
        "MODER7"
      ],
      "reason": "PB6/PB7 alternate for I2C1: the model routes a pin by MODER only for a timer channel (4300 FEEDBACK section 0). The bench row reads MODER back, as 3302 B2 did."
    },
    {
      "register": "GPIOB.OSPEEDR",
      "class": "same-source",
      "fields": [
        "OSPEED6",
        "OSPEED7"
      ],
      "reason": "PB6/PB7 for I2C1 at 400 kHz: no edge rate is modelled; check speeds judges the chosen speed's fmax with svd-hal's own table, not an ir rule. The bench row reads OSPEEDR back."
    },
    {
      "register": "GPIOB.OTYPER",
      "class": "ignored-by-model",
      "fields": [
        "OT0",
        "OT1",
        "OT2",
        "OT3",
        "OT4",
        "OT5",
        "OT6",
        "OT7",
        "OT8",
        "OT9",
        "OT10",
        "OT11",
        "OT12",
        "OT13",
        "OT14",
        "OT15"
      ],
      "reason": "OTYPER is not stored by Renode (4300b FEEDBACK section 10): PB6/PB7 open-drain for I2C1, the rest push-pull. 3302 B2 reads it on silicon; the bench row compares it."
    },
    {
      "register": "GPIOB.PUPDR",
      "class": "same-source",
      "fields": [
        "PUPD0",
        "PUPD1",
        "PUPD2",
