# class: unmodelled-item
# note: F.Cu renamed TOP and a gr_rect on TOP (F10); since AET-WO-1311 the strict reader refuses the name before any gate (before it: drc 5 ToolError kicad-cli; drc-parity 3 LayersDisagree; extract 3 UnmodelledCopper)
# main: drc 5 ToolError kicad-cli; drc-parity 5 ToolError kicad-cli; extract 3 UnmodelledCopper
# drc: 3 MalformedBoard kicad_pcb/gr_rect[2]/layer[1]
# drc-parity: 3 MalformedBoard kicad_pcb/gr_rect[2]/layer[1]
# extract: 3 MalformedBoard kicad_pcb/gr_rect[2]/layer[1]
@@ find
		(0 "F.Cu" signal)
@@ replace
		(0 "F.Cu" signal "TOP")
@@ end
@@ find
	)
	(embedded_fonts no)
@@ replace
	)
	(gr_rect
		(start 94.5 87.5)
		(end 97 88.5)
		(stroke (width 0.1) (type solid))
		(fill yes)
		(layer "TOP")
	)
	(embedded_fonts no)
@@ end
