# class: repeated-child
# note: a pad's second at: KiCad moves the copper 2.5 mm (A7)
# main: drc 1 fail; drc-parity 1 fail; extract 3 UnmodelledCopper
# drc: 3 MalformedBoard kicad_pcb/footprint[7]/pad[2]
# drc-parity: 3 MalformedBoard kicad_pcb/footprint[7]/pad[2]
# extract: 3 MalformedBoard kicad_pcb/footprint[7]/pad[2]
@@ find
			(net "VDD_3V3")
		)
		(pad "2" smd roundrect
			(at 0.51 0)
			(size 0.54 0.64)
			(layers "F.Cu" "F.Mask" "F.Paste")
			(roundrect_rratio 0.25)
			(net "/I2C_SDA")
@@ replace
			(net "VDD_3V3")
		)
		(pad "2" smd roundrect
			(at 0.51 0)
			(at 0.51 2.5)
			(size 0.54 0.64)
			(layers "F.Cu" "F.Mask" "F.Paste")
			(roundrect_rratio 0.25)
			(net "/I2C_SDA")
@@ end
