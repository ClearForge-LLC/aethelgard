# class: repeated-child
# note: a footprint's second at: KiCad moves the part (A7)
# main: drc 1 fail; drc-parity 1 fail; extract 3 UnmodelledCopper
# drc: 3 MalformedBoard kicad_pcb/footprint[7]
# drc-parity: 3 MalformedBoard kicad_pcb/footprint[7]
# extract: 3 MalformedBoard kicad_pcb/footprint[7]
@@ find
		(at 99 86)
		(descr "Resistor SMD 0402 (1005 Metric), square (rectangular) end terminal, IPC-7351 nominal, (Body size source: IPC-SM-782 page 72, https://www.pcb-3d.com/wordpress/wp-content/uploads/ipc-sm-782a_amendment_1_and_2.pdf)")
@@ replace
		(at 99 86)
		(at 99 89)
		(descr "Resistor SMD 0402 (1005 Metric), square (rectangular) end terminal, IPC-7351 nominal, (Body size source: IPC-SM-782 page 72, https://www.pcb-3d.com/wordpress/wp-content/uploads/ipc-sm-782a_amendment_1_and_2.pdf)")
@@ end
