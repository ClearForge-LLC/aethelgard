# class: repeated-child
# note: a second (end 96.625 98): KiCad reads the last end (A2)
# main: drc 1 fail; drc-parity 1 fail; extract 3 UnmodelledCopper
# drc: 3 MalformedBoard kicad_pcb/segment[53]
# drc-parity: 3 MalformedBoard kicad_pcb/segment[53]
# extract: 3 MalformedBoard kicad_pcb/segment[53]
@@ find
		(start 94.75 88)
		(end 96.625 88)
		(width 0.2)
		(layer "B.Cu")
@@ replace
		(start 94.75 88)
		(end 96.625 88)
		(end 96.625 98)
		(width 0.2)
		(layer "B.Cu")
@@ end
