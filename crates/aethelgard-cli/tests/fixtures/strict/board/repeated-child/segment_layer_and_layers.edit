# class: repeated-child
# note: parsePCB_TRACK sets a track's layers from either `layer` or `layers`; the second wins
# main: drc 1 fail; drc-parity 1 fail; extract 3 UnmodelledCopper
# drc: 3 MalformedBoard kicad_pcb/segment[42]
# drc-parity: 3 MalformedBoard kicad_pcb/segment[42]
# extract: 3 MalformedBoard kicad_pcb/segment[42]
@@ find
		(start 92.75 86.125)
		(end 92.75 90.625)
		(width 0.2)
		(layer "B.Cu")
@@ replace
		(start 92.75 86.125)
		(end 92.75 90.625)
		(width 0.2)
		(layer "B.Cu")
		(layers "F.Cu")
@@ end
