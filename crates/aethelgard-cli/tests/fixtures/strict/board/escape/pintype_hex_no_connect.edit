# class: escape
# note: as pintype_octal_no_connect, spelt \x5f (adversarial B2)
# main: drc 0 pass; drc-parity 0 pass; extract 3 UnmodelledCopper
# drc: 3 MalformedBoard
# drc-parity: 3 MalformedBoard
# extract: 3 BoardUnreadable
@@ find
			(layers "F.Cu" "F.Mask" "F.Paste")
			(roundrect_rratio 0.25)
			(net "/I2C_SDA")
		)
		(pad "138" smd roundrect
@@ replace
