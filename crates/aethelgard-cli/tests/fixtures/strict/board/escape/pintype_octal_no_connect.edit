# class: escape
# note: U1 pad 137 moved to /I2C_SDA_X, its branch removed, pintype "bidirectional+no\137connect": KiCad's DSNLEXER decodes \137 as `_` (no_connect); main's gate read no137connect, so check drc --spec --schematic passed (adversarial B2, 1301 A6 reopened)
# main: drc 0 pass; drc-parity 0 pass; extract 3 UnmodelledCopper
# drc: 3 MalformedBoard
# drc-parity: 3 MalformedBoard
# extract: 3 BoardUnreadable
@@ find
			(layers "F.Cu" "F.Mask" "F.Paste")
			(roundrect_rratio 0.25)
			(net "/I2C_SDA")
		)
		(pad "138" smd roundrect
@@ replace
			(layers "F.Cu" "F.Mask" "F.Paste")
			(roundrect_rratio 0.25)
			(net "/I2C_SDA_X")
			(pintype "bidirectional+no\137connect")
		)
		(pad "138" smd roundrect
@@ end
@@ find
	(segment
		(start 94.75 88.625)
		(end 94.75 88.75)
		(width 0.2)
		(layer "F.Cu")
		(net "/I2C_SDA")
		(uuid "c64ccc4a-c11e-8d07-83d4-e48e2ca04b15")
	)
	(segment
@@ replace
	(segment
@@ end
