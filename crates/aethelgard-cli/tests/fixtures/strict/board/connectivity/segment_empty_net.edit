# class: connectivity
# note: a segment with an empty net name
# main: drc 1 fail; drc-parity 1 fail; extract 3 NetLabelsDisagree
# drc: 1 fail
# drc-parity: 1 fail
# extract: 3 NetLabelsDisagree
@@ find
	)
	(embedded_fonts no)
@@ replace
	)
	(segment
		(start 74 115)
		(end 80 115)
		(width 0.2)
		(layer "B.Cu")
		(net "")
	)
	(embedded_fonts no)
@@ end
