# class: parts
# note: R1 relabelled a 100 nF capacitor C99 (B1); only the specification's design says what R1 is
# main: drc 1 fail; drc-parity 1 fail; extract 3 DeviceNotOnLine
# drc: 1 fail
# drc-parity: 1 fail
# extract: 3 DeviceNotOnLine
@@ find
	(footprint "Resistor_SMD:R_0402_1005Metric"
		(layer "F.Cu")
		(uuid "92903487-1d17-8b75-8b25-34438f6a4a68")
		(at 99 86)
		(descr "Resistor SMD 0402 (1005 Metric), square (rectangular) end terminal, IPC-7351 nominal, (Body size source: IPC-SM-782 page 72, https://www.pcb-3d.com/wordpress/wp-content/uploads/ipc-sm-782a_amendment_1_and_2.pdf)")
		(tags "resistor")
		(property "Reference" "R1"
			(at 0 -1.17 0)
			(layer "F.SilkS")
			(effects
				(font
					(size 1 1)
					(thickness 0.15)
				)
			)
		)
		(property "Value" "2k2"
@@ replace
	(footprint "Capacitor_SMD:C_0402_1005Metric"
		(layer "F.Cu")
		(uuid "92903487-1d17-8b75-8b25-34438f6a4a68")
		(at 99 86)
		(descr "Resistor SMD 0402 (1005 Metric), square (rectangular) end terminal, IPC-7351 nominal, (Body size source: IPC-SM-782 page 72, https://www.pcb-3d.com/wordpress/wp-content/uploads/ipc-sm-782a_amendment_1_and_2.pdf)")
		(tags "resistor")
		(property "Reference" "C99"
			(at 0 -1.17 0)
			(layer "F.SilkS")
			(effects
				(font
					(size 1 1)
					(thickness 0.15)
				)
			)
		)
		(property "Value" "100n"
@@ end
