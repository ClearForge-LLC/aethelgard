# class: coordinate
# note: a pad 9 km away; extract bounds every coordinate (E8)
# main: drc 1 fail; drc-parity 1 fail; extract 3 BoardTooLarge
# drc: 1 fail
# drc-parity: 1 fail
# extract: 3 BoardTooLarge
@@ find
	)
	(embedded_fonts no)
@@ replace
	)
	(footprint "TestPoint:TP"
		(layer "F.Cu")
		(at 9000000 100)
		(property "Reference" "TP1")
		(pad "1" smd rect
			(at 0 0)
			(size 1 1)
			(layers "F.Cu")
		)
	)
	(embedded_fonts no)
@@ end
