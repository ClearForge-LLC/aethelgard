# AET-WO-2100 spike S4: one boot for a fixed virtual time. The caller sets
# $platform, $elf and $time, and may run `emulation SetSeed` first.
logLevel 3
mach create
machine LoadPlatformDescription $platform
sysbus LoadELF $elf
emulation RunFor $time
echo "OBSERVED"
sysbus ReadDoubleWord 0x20000000
cpu PC
cpu ExecutedInstructions
sysbus ReadDoubleWord 0x58020000
sysbus ReadDoubleWord 0x58020014
sysbus ReadDoubleWord 0x58020020
sysbus ReadDoubleWord 0x58020400
sysbus ReadDoubleWord 0x58020420
sysbus ReadDoubleWord 0x40005400
sysbus ReadDoubleWord 0x40013000
echo "UID"
sysbus ReadDoubleWord 0x1FF1E800
sysbus ReadDoubleWord 0x1FF1E804
echo "TIME"
emulation GetTimeSourceInfo
cpu PerformanceInMips
quit
