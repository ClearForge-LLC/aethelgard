+//! PROBE (AET-WO-4300c §1.3), not for commit.
+use aethelgard_eda::{extract, stack::Stack};
+use std::path::PathBuf;
+
+fn root() -> PathBuf {
+    PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../..")
+}
+
+#[test]
+fn probe() {
+    for f in [
+        "examples/sentinel-01-minimal.json",
+        "crates/aethelgard-cli/tests/fixtures/four-layer.json",
+        "crates/aethelgard-cli/tests/fixtures/d1-24-i2c.json",
+        "crates/aethelgard-cli/tests/fixtures/spi-imu.json",
+    ] {
+        let bytes = std::fs::read(root().join(f)).unwrap();
+        let spec: aethelgard_ir::Specification = serde_json::from_slice(&bytes).unwrap();
+        spec.validate().unwrap();
+        let table = aethelgard_svd_hal::pin_table(&spec.mcu.part).unwrap();
+        let solved = aethelgard_ir::solve(&spec, &table, &"0".repeat(64)).unwrap();
+        let em = aethelgard_eda::schematic::emit(&spec, &solved, &table).unwrap();
+        let stack = Stack::of(&spec);
+        let read = extract::read(&em.board, &stack).unwrap();
+        let i2c = extract::bound(&read, &extract::lines(&spec, &solved, &table).unwrap()).unwrap();
+        let mut nets = Vec::new();
+        for b in &spec.spi_buses {
+            for s in [&b.sck, &b.mosi, &b.miso] {
+                nets.push((s.net.clone(), b.id.clone()));
+            }
+        }
+        #[allow(clippy::disallowed_methods)]
+        for d in spec.declared_spi_devices() {
+            nets.push((d.cs.net.clone(), d.bus.clone()));
+        }
+        let spi = extract::probe_lines(&spec, &solved, &table, &nets)
+            .and_then(|l| extract::bound(&read, &l));
+        let spi = match spi {
+            Ok(s) => s,
+            Err(e) => panic!("{f}: {} {}", e.kind, e.message),
+        };
+        for (kind, b) in i2c.iter().map(|b| ("i2c", b)).chain(spi.iter().map(|b| ("spi", b))) {
+            println!(
+                "PROBE {}\t{kind}\t{}\t{}\ttrace={} vias={} pads={} pins={}\ttotal={}\tsegs={} vias#={} len_nm={}\t{:?}",
+                f.rsplit('/').next().unwrap(),
+                b.bus,
+                b.net,
+                b.terms.trace,
+                b.terms.vias,
+                b.terms.pads,
+                b.terms.pins,
+                b.c_bound_femtofarads,
+                b.segments,
+                b.via_count,
+                b.length_nm,
+                b.pins
+            );
+        }
+    }
+}
