+/// PROBE (AET-WO-4300c §1.3), not for commit: the line list widened to any
+/// net, every non-passive part a pin part, any passive refused by name.
+#[doc(hidden)]
+pub fn probe_lines(
+    spec: &Specification,
+    solved: &SolvedTopology,
+    table: &PinTable,
+    nets: &[(String, String)],
+) -> Result<Vec<Line>, Refused> {
+    let (parts, _) = crate::schematic::design(spec, solved, table).map_err(|e| invalid(&e))?;
+    let mut out = Vec::new();
+    for (net, bus) in nets {
+        let on = board_net(net);
+        let mut roles = BTreeMap::new();
+        for part in &parts {
+            let pads: BTreeSet<String> = crate::pcb::pin_nets(part)
+                .map_err(|e| invalid(&e))?
+                .into_iter()
+                .filter(|(_, n)| *n == on)
+                .map(|(p, _)| p)
+                .collect();
+            if pads.is_empty() {
+                continue;
+            }
+            if part.lib_id == crate::schematic::R || part.lib_id == crate::schematic::C {
+                return Err(refused(
+                    "UnmodelledPart",
+                    format!("PROBE: passive {} on `{net}`", part.reference),
+                ));
+            }
+            roles.insert(
+                part.reference.clone(),
+                Role {
+                    footprint: part.footprint.clone(),
+                    value: part.value.clone(),
+                    pads,
+                    pin: true,
+                },
+            );
+        }
+        out.push(Line {
+            net: net.clone(),
+            bus: bus.clone(),
+            parts: roles,
+        });
+    }
+    Ok(out)
+}
