+        if let Some(p) = std::env::var_os("AET1323_WORK_LOG") {
+            use std::io::Write;
+            let mut f = std::fs::OpenOptions::new().create(true).append(true).open(p).unwrap();
+            f.write_all(line.as_bytes()).unwrap();
+        }
+    }
