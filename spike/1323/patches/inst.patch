+        nets,
+        outcome,
+        get(&spike_work::SEARCH),
+        get(&spike_work::PAIR),
+        get(&spike_work::FLOOD),
+        wall,
+        spike_work::SEARCH_NS.with(|v| v.get()) / 1_000_000,
+        ripups,
+        why
+    ));
+    r
