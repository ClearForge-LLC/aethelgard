     /// Takes `net`'s copper up and makes its corridors pending again.
+    /// AET-WO-1323 prototype: take off every end of `net`'s copper that is
+    /// in none of its pads (a leaf of its edges, no via there), until none is
+    /// left. True if any was taken.
+    fn prune(&mut self, net: usize) -> bool {
+        let reach: Vec<Rect> = self
+            .board
+            .parts
+            .iter()
+            .flat_map(|p| &p.pads)
+            .filter(|p| p.net.as_deref() == Some(self.nets[net].as_str()))
+            .map(|p| p.reach())
+            .collect();
+        let mut any = false;
+        loop {
+            let mut cut = false;
+            for li in 0..2 {
+                let mut degree: BTreeMap<usize, usize> = BTreeMap::new();
+                for &(a, b) in &self.edges[net][li] {
+                    *degree.entry(a).or_default() += 1;
+                    *degree.entry(b).or_default() += 1;
+                }
+                let leaves: Vec<usize> = degree
+                    .iter()
+                    .filter(|&(&n, &d)| {
+                        let (x, y) = self.grid.at(n);
+                        d == 1
+                            && !self.vias.contains_key(&n)
+                            && !reach.iter().any(|r| r.contains(Rect::point(x, y)))
+                    })
+                    .map(|(&n, _)| n)
+                    .collect();
+                for leaf in leaves {
+                    self.edges[net][li].retain(|&(a, b)| a != leaf && b != leaf);
+                    cut = true;
+                }
+            }
+            if !cut {
+                break;
+            }
+            any = true;
+        }
+        if any && std::env::var_os("AET1323_STUB_DUMP").is_some() {
+            eprintln!("PRUNED {}", self.nets[net]);
+        }
+        any
+    }
