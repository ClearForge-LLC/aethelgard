+                    *degree.entry(a).or_default() += 1;
+                    *degree.entry(b).or_default() += 1;
+                }
+                let leaves: Vec<usize> = degree
+                    .iter()
+                    .filter(|&(&n, &d)| {
+                        let (x, y) = self.grid.at(n);
+                        d == 1
+                            && !self.vias.contains_key(&n)
+                            && !reach.iter().any(|r| r.contains(Rect::point(x, y)))
+                    })
+                    .map(|(&n, _)| n)
+                    .collect();
+                for leaf in leaves {
+                    self.edges[net][li].retain(|&(a, b)| a != leaf && b != leaf);
+                    cut = true;
+                }
+            }
+            if !cut {
+                break;
+            }
+            any = true;
+        }
+        any
+    }
