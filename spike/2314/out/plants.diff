+// ---------------------------------------------------------------- AET-WO-2314 (spike)
+
+/// SPIKE 2314 §1.1: each cause of an undisturbed boot with no boot word,
+/// planted, and the campaign's refusal printed.
+#[test]
+fn spike_2314_each_cause_today() {
+    let magic_hook = "BOOTWORD 2100b007 0 2575";
+    let first_read = "AETHELGARD-BOOT-BEGIN\n0x2100B007\n";
+    let flood = "[00:00:00.040000000] [WARNING] i2c1: Receive buffer underflow!\n".repeat(160_000);
+    let word = |w: &str, hook: &str| {
+        good()
+            .replacen(magic_hook, &format!("BOOTWORD {hook} 0 2575"), 1)
+            .replacen(first_read, &format!("AETHELGARD-BOOT-BEGIN\n{w}\n"), 1)
+    };
+    let plants: Vec<(&str, String, &str)> = vec![
+        ("memory", good(), common::HOLD_PAST_CAP),
+        ("flood", text(&format!("{GOOD_WITNESS}{flood}"), GOOD_RECORD, CPU_LISTING), ""),
+        ("fault word", word("0xDEADBEEF", "deadbeef"), ""),
+        ("park code", word("0x2100B0F5", "2100b0f5"), ""),
+        ("no write", good().replacen(&injection(0), "", 1).replacen(first_read, "AETHELGARD-BOOT-BEGIN\n0x00000000\n", 1), ""),
+        ("magic, no hook", good().replacen(&injection(0), "", 1), ""),
+    ];
+    for (name, out, then) in plants {
+        let tb = toolbox_built_then(&out, BUILD, then);
+        let work = Work::new();
+        let o = campaign(
+            &cli(Some(DROOP_BRIDGE)),
+            &tb.0,
+            &work.dir.0,
+            &[STUB_DROOP],
+            &work.firmware,
+            &work.archive,
+        );
+        println!(
+            "ANSWER 2314: plant {name}: exit={:?} {}",
+            o.status.code(),
+            String::from_utf8_lossy(&o.stdout).trim()
+        );
+    }
+    // The same stubs under `simulate` (the verdict the campaign's boot(None) returns).
+    let plants2: Vec<(&str, String, &str)> = vec![
+        ("memory", good(), common::HOLD_PAST_CAP),
+        ("flood", text(&format!("{GOOD_WITNESS}{flood}"), GOOD_RECORD, CPU_LISTING), ""),
+        ("fault word", word("0xDEADBEEF", "deadbeef"), ""),
+        ("park code", word("0x2100B0F5", "2100b0f5"), ""),
+        ("no write", good().replacen(&injection(0), "", 1).replacen(first_read, "AETHELGARD-BOOT-BEGIN\n0x00000000\n", 1), ""),
+        ("magic, no hook", good().replacen(&injection(0), "", 1), ""),
+    ];
+    for (name, out, then) in plants2 {
+        let tb = toolbox_built_then(&out, BUILD, then);
+        let work = Work::new();
+        let g = run_cli(&cli(Some(DROOP_BRIDGE)), &tb.0, &work.dir.0, &[os("generate"), os("--spec"), os("spec.json"), os("--out"), os("gen")]);
+        assert_eq!(g.status.code(), Some(0), "{}", String::from_utf8_lossy(&g.stdout));
+        let repl = fs::read_dir(work.dir.0.join("gen/board")).unwrap().map(|e| e.unwrap().path()).find(|p| p.extension().is_some_and(|e| e == "repl")).unwrap();
+        let o = run_cli(&cli(Some(DROOP_BRIDGE)), &tb.0, &work.dir.0, &[os("simulate"), os("--spec"), os("spec.json"), os("--platform"), repl.as_os_str(), os("--firmware"), work.firmware.as_os_str(), os("--for"), os("100ms")]);
+        let v: Value = serde_json::from_slice(&o.stdout).unwrap_or(Value::Null);
+        let f: Vec<String> = v["findings"].as_array().map(|a| a.iter().map(|f| format!("{}[{}]: {}", f["kind"].as_str().unwrap_or(""), f["severity"].as_str().unwrap_or(""), f["message"].as_str().unwrap_or(""))).collect()).unwrap_or_default();
+        println!("ANSWER 2314: simulate {name}: exit={:?} boot_word_ns={} word={} memory={} error={}", o.status.code(), v["boot"]["boot_word_ns"], v["boot"]["boot_word"]["observed"], v["memory"], v["error"]);
+        for x in f { println!("    {x}"); }
+    }
+}
