logLevel 0
emulation SetSeed 2101
mach create "s3"
include @/repo/spike/2101/renode/Sensor.cs
machine LoadPlatformDescription @/repo/spike/2101/renode/ii.repl
sysbus LoadELF @/repo/spike/2101/renode/fw.elf
sysbus.cpu VectorTableOffset 0x08000000
sysbus WriteDoubleWord 0x20000100 1
emulation RunFor "0.010000000"
logLevel 3
echo "BEGIN t1-normal"
include @/repo/spike/2101/renode/dump.resc
echo "END"
logLevel 0
sysbus.i2c1.sensor Fault 1
sysbus WriteDoubleWord 0x20000100 2
emulation RunFor "0.010000000"
logLevel 3
echo "BEGIN t2-nobytes"
include @/repo/spike/2101/renode/dump.resc
echo "END"
logLevel 0
sysbus.i2c1.sensor Fault 2
sysbus WriteDoubleWord 0x20000100 3
emulation RunFor "0.010000000"
logLevel 3
echo "BEGIN t3-corrupt"
include @/repo/spike/2101/renode/dump.resc
echo "END"
logLevel 0
sysbus.i2c1.sensor Fault 0
sysbus WriteDoubleWord 0x20000100 4
emulation RunFor "0.010000000"
logLevel 3
echo "BEGIN t4-normal"
include @/repo/spike/2101/renode/dump.resc
echo "END"
logLevel 0
quit
