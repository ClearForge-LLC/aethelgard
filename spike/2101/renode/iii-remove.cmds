logLevel 0
emulation SetSeed 2101
mach create "s3"
machine LoadPlatformDescription @/repo/spike/2101/renode/iii-present.repl
sysbus LoadELF @/repo/spike/2101/renode/fw.elf
sysbus.cpu VectorTableOffset 0x08000000
sysbus WriteDoubleWord 0x20000100 1
emulation RunFor "0.010000000"
logLevel 3
echo "BEGIN t1-present"
include @/repo/spike/2101/renode/dump.resc
echo "END"
logLevel 0
sysbus.i2c1 Unregister sysbus.i2c1.bme
sysbus WriteDoubleWord 0x20000100 2
emulation RunFor "0.010000000"
logLevel 3
echo "BEGIN t2-after-unregister"
include @/repo/spike/2101/renode/dump.resc
echo "END"
logLevel 0
machine LoadPlatformDescriptionFromString "bme: I2C.BME280 @ i2c1 0x76"
sysbus WriteDoubleWord 0x20000100 3
emulation RunFor "0.010000000"
logLevel 3
echo "BEGIN t3-after-reregister"
include @/repo/spike/2101/renode/dump.resc
echo "END"
logLevel 0
quit
