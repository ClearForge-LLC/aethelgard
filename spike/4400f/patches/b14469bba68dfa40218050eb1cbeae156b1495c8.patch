+++ b/src/Emulator/Peripherals/Peripherals/Miscellaneous/STM32H7_RCC.cs
@@ -54,6 +54,7 @@ public void Register(IPeripheral peripheral, EnumRegistrationPoint<RegistrationP
             }
 
             RegisteredPeripherals.Add(registrationPoint.Name, peripheral);
+            PropagateClock();
         }
 
         public void Unregister(IPeripheral peripheral)
