@@ -33,6 +33,25 @@ pub const TIMER_HZ: u64 = 250_000_000;
 /// One timer tick of the model at [`TIMER_HZ`] with `PSC + 1` = 1, in ns.
 pub const CYCLE_NS: u64 = 1_000_000_000 / TIMER_HZ;
 
+/// SPIKE AET-WO-4400f: the judge's timer frequency, `AET4400F_TIMER_HZ` or [`TIMER_HZ`].
+pub fn spike_timer_hz() -> u64 {
+    std::env::var("AET4400F_TIMER_HZ").ok().or(option_env!("AET4400F_TIMER_HZ").map(String::from)).map_or(TIMER_HZ, |v| v.parse().expect("AET4400F_TIMER_HZ"))
+}
+
+/// SPIKE AET-WO-4400f: whether a candidate switch is on; off, the judge is main's.
+pub fn spike_active() -> bool {
+    spike_timer_hz() != TIMER_HZ || std::env::var("AET4400F_CEIL").is_ok() || option_env!("AET4400F_CEIL").is_some()
+}
+
+fn spike_ps(ticks: u64) -> u64 {
+    let hz = spike_timer_hz();
+    if std::env::var("AET4400F_CEIL").is_ok() || option_env!("AET4400F_CEIL").is_some() {
+        (ticks * 1_000_000_000).div_ceil(hz) * 1000
+    } else {
+        ticks * 1_000_000_000_000 / hz
+    }
+}
