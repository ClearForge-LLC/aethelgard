+/// SPIKE AET-WO-4400f (labelled deviation, never on the branch): with
+/// `AET4400F_CLOCK=solved`, each timer and USART instance gets an update entry
+/// with the solved clock's kernel frequency (candidate (a)); with
+/// `AET4400F_CLOCK=declared:timers=HZ,usart1=HZ` the declared values (candidate (c)).
+fn spike_4400f_clock(out: &mut String, topology: &SolvedTopology) {
+    let Some(mode) = std::env::var("AET4400F_CLOCK").ok().or(option_env!("AET4400F_CLOCK").map(String::from)) else { return };
+    let mut entries: Vec<(String, u64)> = Vec::new();
+    if mode == "solved" {
+        let c = &topology.clock;
+        for n in TIMERS {
+            entries.push((format!("timer{n}"), c.timer_kernel_hz(aethelgard_ir::motor::apb(n))));
+        }
+        for (inst, p) in [("usart1", "USART1"), ("usart2", "USART2"), ("usart3", "USART3"), ("uart4", "UART4"),
+                          ("uart5", "UART5"), ("usart6", "USART6"), ("uart7", "UART7"), ("uart8", "UART8")] {
+            if let Some(hz) = aethelgard_ir::serial::kernel_hz(c, p) {
+                entries.push((inst.to_owned(), hz));
+            }
+        }
+    } else if let Some(d) = mode.strip_prefix("declared:") {
+        for kv in d.split(',') {
+            let (k, v) = kv.split_once('=').expect("key=hz");
+            let hz: u64 = v.parse().expect("hz");
+            if k == "timers" {
+                for n in TIMERS {
+                    entries.push((format!("timer{n}"), hz));
+                }
+            } else {
+                entries.push((k.to_owned(), hz));
+            }
+        }
+    } else {
+        panic!("AET4400F_CLOCK: {mode}");
+    }
+    out.push_str("\n// SPIKE AET-WO-4400f: the clock as update entries.\n");
+    for (inst, hz) in entries {
+        let _ = writeln!(out, "{inst}:\n    frequency: {hz}\n");
+    }
+}
