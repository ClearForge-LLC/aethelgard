+// ---- AET-WO-1307 S3 spike: renaming hook ----
+fn spike_hash(seed: u64, s: &str) -> u64 {
+    let mut h: u64 = 0xcbf29ce484222325 ^ seed.wrapping_mul(0x9e3779b97f4a7c15);
+    for b in s.bytes() {
+        h ^= b as u64;
+        h = h.wrapping_mul(0x100000001b3);
+    }
+    h ^= h >> 29;
+    h = h.wrapping_mul(0xbf58476d1ce4e5b9);
+    h ^ (h >> 32)
+}
+
+fn spike_rename(board: &route::Board, seed: u64) -> route::Board {
+    let planes = board.stack.has_planes();
+    let net = |n: &str| -> String {
+        if n.starts_with(parity::UNCONNECTED) || (!planes && n == route::GROUND) {
+            n.to_owned()
+        } else {
+            format!("{:04x}_{n}", spike_hash(seed, n) & 0xffff)
+        }
+    };
+    let mut b = board.clone();
+    for part in &mut b.parts {
+        part.reference = format!("{:04x}_{}", spike_hash(seed ^ 77, &part.reference) & 0xffff, part.reference);
+        for pad in &mut part.pads {
+            if let Some(n) = &pad.net {
+                pad.net = Some(net(n));
+            }
+        }
+    }
+    for (_, n) in &mut b.stack.planes {
+        *n = net(n);
+    }
+    b
+}
+
+fn spike_digest(r: &route::Routed) -> String {
+    let mut segs: Vec<(u8, (i64, i64), (i64, i64))> = r
+        .segments
+        .iter()
+        .map(|s| {
+            let (a, c) = if s.start <= s.end { (s.start, s.end) } else { (s.end, s.start) };
+            (s.layer as u8, a, c)
+        })
+        .collect();
+    segs.sort();
+    let mut vias: Vec<(i64, i64)> = r.vias.iter().map(|v| v.at).collect();
+    vias.sort();
+    let mut h: u64 = 0xcbf29ce484222325;
+    let mut f = |x: i64| {
+        for b in x.to_le_bytes() {
+            h ^= b as u64;
+            h = h.wrapping_mul(0x100000001b3);
+        }
+    };
+    for (l, a, c) in &segs {
+        f(*l as i64);
+        f(a.0);
+        f(a.1);
+        f(c.0);
+        f(c.1);
+    }
+    f(-1);
+    for v in &vias {
+        f(v.0);
+        f(v.1);
+    }
+    format!("{h:016x}")
+}
