+/// The empty interior of a pad ring: bounded by the inner edges of the pads
+/// nearest the field's centre line on each side; none if a side has no pad,
+/// a pad lies inside, or it is under 4 mm across.
+fn ring_interior(pads: &[Rect], field: Rect) -> Option<Rect> {
+    let (cx, cy) = ((field.x0 + field.x1) / 2, (field.y0 + field.y1) / 2);
+    let (qw, qh) = ((field.x1 - field.x0) / 4, (field.y1 - field.y0) / 4);
+    let mid = |p: &Rect| ((p.x0 + p.x1) / 2, (p.y0 + p.y1) / 2);
+    let xl = pads.iter().filter(|p| mid(p).0 < cx && (mid(p).1 - cy).abs() < qh).map(|p| p.x1).max()?;
+    let xr = pads.iter().filter(|p| mid(p).0 > cx && (mid(p).1 - cy).abs() < qh).map(|p| p.x0).min()?;
+    let yb = pads.iter().filter(|p| mid(p).1 < cy && (mid(p).0 - cx).abs() < qw).map(|p| p.y1).max()?;
+    let yt = pads.iter().filter(|p| mid(p).1 > cy && (mid(p).0 - cx).abs() < qw).map(|p| p.y0).min()?;
+    let r = Rect { x0: xl, y0: yb, x1: xr, y1: yt };
+    if xr - xl < 4_000_000 || yt - yb < 4_000_000 {
+        return None;
+    }
+    if pads.iter().any(|p| p.x0 < r.x1 && p.x1 > r.x0 && p.y0 < r.y1 && p.y1 > r.y0) {
+        return None;
+    }
+    Some(r)
 }
 
