+/// AET-WO-1317 spike: trace and knock-out knobs (scratch copy only).
+pub mod knob {
+    use std::cell::{Cell, RefCell};
+    thread_local! {
+        pub static TRACE: RefCell<Option<Vec<String>>> = const { RefCell::new(None) };
+        pub static NO_K: Cell<bool> = const { Cell::new(false) };
+        pub static NO_M: Cell<bool> = const { Cell::new(false) };
+        pub static NO_S: Cell<bool> = const { Cell::new(false) };
+        pub static ORDER: RefCell<Option<Vec<String>>> = const { RefCell::new(None) };
+        pub static SALT: Cell<u64> = const { Cell::new(0) };
+        pub static ROUNDS: Cell<Option<usize>> = const { Cell::new(None) };
+    }
+    pub fn tr(f: impl FnOnce() -> String) {
+        TRACE.with(|t| {
+            if let Some(v) = t.borrow_mut().as_mut() {
+                v.push(f());
+            }
+        });
+    }
+}
+use knob::tr;
+
+fn rs(r: Rect) -> String {
+    format!("[{},{},{},{}]", r.x0, r.y0, r.x1, r.y1)
+}
