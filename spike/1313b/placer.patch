+/// The name-free target: `k`, the anchor's lowest-numbered pad on any shared
+/// net; `m`, the centroid of the anchor's pads on every shared net.
+fn spike_target(item: &Item<'_>, anchor: &Item<'_>, at: (i64, i64)) -> Option<(i64, i64)> {
+    let shared = item.shared(anchor);
+    let pads: Vec<(&String, (i64, i64))> = anchor
+        .pads
+        .iter()
+        .filter(|(_, (_, n))| shared.contains(n))
+        .map(|(num, (p, _))| (num, *p))
+        .collect();
+    if pads.is_empty() {
+        return None;
+    }
+    if spike('m') {
+        let n = i64::try_from(pads.len()).unwrap_or(1);
+        let (sx, sy) = pads.iter().fold((0, 0), |s, (_, p)| (s.0 + p.0, s.1 + p.1));
+        Some((at.0 + sx / n, at.1 + sy / n))
+    } else {
+        pads.iter()
+            .min_by_key(|(num, _)| pad_order(num))
+            .map(|(_, p)| (at.0 + p.0, at.1 + p.1))
+    }
+}
