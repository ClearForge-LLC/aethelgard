+/// A placed item's pads on board coordinates, with their nets.
+fn board_pads<'a>(it: &'a Item<'_>, p: &Placed) -> impl Iterator<Item = ((i64, i64), &'a str)> + 'a {
+    let (o, rot) = (p.origin, p.rotation);
+    it.pads.values().map(move |(at, n)| {
+        let r = route::rotate(rot, *at);
+        ((o.0 + r.0, o.1 + r.1), n.as_str())
+    })
+}
+
+/// `t`: a signal test pad at the free spot nearest to any placed pad of its
+/// net; a `GND` test pad beside the signal test pad farthest from every
+/// `GND` test pad so far (the first beside the one nearest all of them).
+fn spike_test_pad(
+    item: &Item<'_>,
+    items: &[Item<'_>],
+    placed: &[Option<Placed>],
+    g: Geometry,
+    taken: &[(Rect, i64)],
+) -> Option<(i64, i64)> {
+    let ((own, net), _) = item.pads.values().map(|(a, n)| ((*a, n.as_str()), ())).next()?;
+    let d2 = |a: (i64, i64), b: (i64, i64)| {
+        let (dx, dy) = (i128::from(a.0 - b.0), i128::from(a.1 - b.1));
+        dx * dx + dy * dy
+    };
+    let tps = |gnd: bool| -> Vec<(i64, i64)> {
+        items
+            .iter()
+            .zip(placed)
+            .filter(|(it, _)| it.part.lib_id == schematic::TEST_POINT)
+            .filter_map(|(it, p)| p.as_ref().map(|p| (it, p)))
+            .flat_map(|(it, p)| board_pads(it, p).collect::<Vec<_>>())
+            .filter(|(_, n)| (*n == GND) == gnd)
+            .map(|(a, _)| a)
+            .collect()
+    };
+    let targets: Vec<(i64, i64)> = if net == GND {
+        let signal = tps(false);
+        let grounds = tps(true);
+        let pick = if grounds.is_empty() {
+            signal.iter().min_by_key(|&&a| {
+                (signal.iter().map(|&b| d2(a, b)).max().unwrap_or(0), a.1, a.0)
+            })
+        } else {
+            signal.iter().max_by_key(|&&a| {
+                (
+                    grounds.iter().map(|&b| d2(a, b)).min().unwrap_or(0),
+                    std::cmp::Reverse(a.1),
+                    std::cmp::Reverse(a.0),
+                )
+            })
+        };
+        stat("tp_gnd_rule", 1);
+        pick.into_iter().copied().collect()
+    } else {
+        items
+            .iter()
+            .zip(placed)
+            .filter(|(it, _)| it.part.lib_id != schematic::TEST_POINT)
+            .filter_map(|(it, p)| p.as_ref().map(|p| (it, p)))
+            .flat_map(|(it, p)| board_pads(it, p).collect::<Vec<_>>())
+            .filter(|(_, n)| *n == net)
+            .map(|(a, _)| a)
+            .collect()
+    };
+    let mut best: Option<((i128, i64, i64), (i64, i64))> = None;
+    for t in targets {
+        if let Some(o) = spot(g, t, taken) {
+            let pad = (o.0 + own.0, o.1 + own.1);
+            let k = (d2(pad, t), t.1, t.0);
+            if best.is_none_or(|(b, _)| k < b) {
+                best = Some((k, o));
+            }
+        }
+    }
+    best.map(|(_, o)| o)
+}
