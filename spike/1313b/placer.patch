+#[derive(Clone, Copy, Default)]
+struct Rule {
+    reserve: Option<i64>,
+    ic: bool,
+    step: usize,
+}
+
+impl Rule {
+    fn gap(a: Rule, b: Rule) -> i64 {
+        let later = if a.step >= b.step { a } else { b };
+        match (later.reserve, a.ic && b.ic) {
+            (Some(r), _) => r,
+            (None, true) => IC_GAP_NM,
+            (None, false) => GAP_NM,
+        }
+    }
+}
