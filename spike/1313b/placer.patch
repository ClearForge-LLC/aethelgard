+/// Each non-MCU IC with every non-IC part anchored to it.
+fn groups(items: &[Item<'_>], placed: &[Option<Placed>], anchor_of: &[Option<usize>]) -> Vec<(usize, Vec<usize>)> {
+    (0..items.len())
+        .filter(|&i| is_ic(items[i].part) && !items[i].part.lib_id.starts_with("MCU_") && placed[i].is_some())
+        .filter(|&i| !schematic::is_connector(items[i].part))
+        .map(|i| {
+            let mut m = vec![i];
+            m.extend((0..items.len()).filter(|&j| anchor_of[j] == Some(i) && !is_ic(items[j].part)));
+            (i, m)
+        })
+        .collect()
+}
+
+fn shift(p: &mut Placed, d: (i64, i64)) {
+    p.origin = (p.origin.0 + d.0, p.origin.1 + d.1);
+    p.keep = p.keep.shift(d);
+    p.courtyard = p.courtyard.shift(d);
+}
+
+/// `s`: each group, a step at a time toward the MCU's courtyard centre: in y
+/// (or, when blocked, sideways to the nearest free column, left first, up to
+/// 10 mm, together with the step in y), then in x. The potential (|dy|, |dx|)
+/// falls lexicographically with every move, so it ends.
+fn compact_sidestep(
+    items: &[Item<'_>],
+    placed: &mut [Option<Placed>],
+    anchor_of: &[Option<usize>],
+    rule: &[Rule],
+    approach: &[Rect],
+    rank: Option<&[usize]>,
+) {
+    let Some(mcu) = (0..items.len())
+        .find(|&i| items[i].part.lib_id.starts_with("MCU_"))
+        .and_then(|i| placed[i].as_ref())
+        .map(|p| p.courtyard.centre())
+    else {
+        return;
+    };
+    let mut gs = groups(items, placed, anchor_of);
+    gs.sort_by_key(|(i, _)| rank.map_or(0, |r| r[*i]));
+    // A move never widens the core: every member stays inside the x-range
+    // the core had before compaction.
+    let Some(core) = placed.iter().flatten().map(|p| p.keep).reduce(Rect::union) else {
+        return;
+    };
+    let clear = |placed: &[Option<Placed>], members: &[usize], d: (i64, i64)| {
+        members.iter().all(|&m| {
+            let Some(p) = placed[m].as_ref() else { return true };
+            let k = p.keep.shift(d);
+            k.x0 >= core.x0
+                && k.x1 <= core.x1
+                && approach.iter().all(|a| !a.overlaps(k))
+                && (0..items.len()).all(|o| {
+                    members.contains(&o)
+                        || placed[o]
+                            .as_ref()
+                            .is_none_or(|q| !q.keep.overlaps(k.grow(Rule::gap(rule[m], rule[o]))))
+                })
+        })
+    };
+    for _ in 0..4 * RINGS {
+        let mut moved = false;
+        for (_, members) in &gs {
+            let Some(c) = members
+                .iter()
+                .filter_map(|&m| placed[m].as_ref().map(|p| p.keep))
+                .reduce(Rect::union)
+                .map(Rect::centre)
+            else {
+                continue;
+            };
+            // No step that would overshoot the MCU's centre.
+            let toward = |v: i64| if v.abs() >= STEP { v.signum() * STEP } else { 0 };
+            let sy = toward(mcu.1 - c.1);
+            let mut d = None;
+            if sy != 0 {
+                if clear(placed, members, (0, sy)) {
+                    d = Some((0, sy));
+                } else {
+                    'side: for j in 1..=40 {
+                        for s in [-1, 1] {
+                            let cand = (s * j * STEP, sy);
+                            if clear(placed, members, cand) {
+                                d = Some(cand);
+                                stat("sidesteps", 1);
+                                break 'side;
+                            }
+                        }
+                    }
+                }
+            }
+            if d.is_none() {
+                let sx = toward(mcu.0 - c.0);
+                if sx != 0 && clear(placed, members, (sx, 0)) {
+                    d = Some((sx, 0));
+                }
+            }
+            if let Some(d) = d {
+                for &m in members {
+                    if let Some(p) = placed[m].as_mut() {
+                        shift(p, d);
+                    }
+                }
+                stat("moves", 1);
+                moved = true;
+            }
+        }
+        if !moved {
+            break;
+        }
+    }
+}
+
+/// `p`: every group (an IC and its non-IC parts, rigid as the placer left
+/// them) repacked by its keep-out box into a skyline as wide as the bound
+/// less the side connector bands, under and beside the MCU's group, which
+/// stays; tallest first, then widest, then by rank; each at the lowest
+/// level, then leftmost. `w`: the strip's width is searched, from the full
+/// width down in 2 mm steps to the MCU group's, keeping the width whose
+/// estimated outline (core plus the side bands and the margins) has the
+/// least area, the narrower on a tie.
+fn skyline(
+    items: &[Item<'_>],
+    placed: &mut [Option<Placed>],
+    anchor_of: &[Option<usize>],
+    bound: OutlineBound,
+    rank: Option<&[usize]>,
+) {
+    let Some(mbox) = mcu_group_box(items, placed, anchor_of) else {
+        return;
+    };
+    let (sides, _) = connector_edges(items, BOUNDED_PLAN);
+    let band = |rot: u16| {
+        sides
+            .iter()
+            .filter(|&&(_, r)| r == rot)
+            .map(|&(i, _)| {
+                let g = items[i].geometry;
+                g.courtyard.y1 - g.keep.y0 + IC_GAP_NM
+            })
+            .max()
+            .unwrap_or(MARGIN_NM)
+    };
+    let bands = band(270) + band(90);
+    let (bw, _) = bound_nm(bound);
+    let full = bw - bands - 2 * SNAP;
+    let widths: Vec<i64> = if spike('w') {
+        (0..)
+            .map(|k| full - k * 2_000_000)
+            .take_while(|w| *w >= mbox.x1 - mbox.x0 + 2 * IC_GAP_NM)
+            .collect()
+    } else {
+        vec![full]
+    };
+    let mut best: Option<((i128, i64), i64)> = None;
+    for &w in &widths {
+        let mut trial = placed.to_vec();
+        if !pack(items, &mut trial, anchor_of, mbox, w, rank) {
+            continue;
+        }
+        let Some(core) = trial.iter().flatten().map(|p| p.keep).reduce(Rect::union) else {
+            continue;
+        };
+        let area = i128::from(core.x1 - core.x0 + bands) * i128::from(core.y1 - core.y0 + 2 * MARGIN_NM);
+        if best.is_none_or(|(k, _)| (area, w) < k) {
+            best = Some(((area, w), w));
+        }
+    }
+    if let Some((_, w)) = best {
+        stat("skyline_width_um", w / 1000);
+        pack(items, placed, anchor_of, mbox, w, rank);
+    }
+}
+
+/// The keep-out box of everything placed that no other group holds: the
+/// MCU's group.
+fn mcu_group_box(items: &[Item<'_>], placed: &[Option<Placed>], anchor_of: &[Option<usize>]) -> Option<Rect> {
+    let gs = groups(items, placed, anchor_of);
+    let in_group: BTreeSet<usize> = gs.iter().flat_map(|(_, m)| m.iter().copied()).collect();
+    (0..items.len())
+        .filter(|j| !in_group.contains(j))
+        .filter_map(|j| placed[j].as_ref().map(|p| p.keep))
+        .reduce(Rect::union)
+}
+
+/// The skyline packing at one strip `width`, centred on the MCU's group.
+fn pack(
+    items: &[Item<'_>],
+    placed: &mut [Option<Placed>],
+    anchor_of: &[Option<usize>],
+    mbox: Rect,
+    width: i64,
+    rank: Option<&[usize]>,
+) -> bool {
+    let gs = groups(items, placed, anchor_of);
+    let mcu = (0..items.len()).find(|&i| items[i].part.lib_id.starts_with("MCU_"));
+    let cx = mcu
+        .and_then(|i| placed[i].as_ref())
+        .map_or(mbox.centre().0, |p| p.courtyard.centre().0);
+    let x0 = (cx - width / 2).div_euclid(SNAP) * SNAP;
+    // Each group's target x: the mean x of the MCU's pads on the label nets
+    // its members carry (a group with none: the MCU's centre).
+    let mcu_pads: Vec<((i64, i64), &str)> = mcu
+        .and_then(|i| placed[i].as_ref().map(|p| board_pads(&items[i], p).collect()))
+        .unwrap_or_default();
+    let target_x = |members: &[usize]| -> i64 {
+        let nets: BTreeSet<&str> = members
+            .iter()
+            .flat_map(|&m| items[m].pads.values().map(|(_, n)| n.as_str()))
+            .filter(|n| n.starts_with('/'))
+            .collect();
+        let xs: Vec<i64> = mcu_pads.iter().filter(|(_, n)| nets.contains(n)).map(|(a, _)| a.0).collect();
+        if xs.is_empty() {
+            cx
+        } else {
+            xs.iter().sum::<i64>() / i64::try_from(xs.len()).unwrap_or(1)
+        }
+    };
+    let cols = usize::try_from(width / SNAP).unwrap_or(0);
+    let col_of = |x: i64| usize::try_from((x - x0).div_euclid(SNAP)).unwrap_or(0);
+    if mbox.x0 < x0 || mbox.x1 > x0 + width {
+        stat("skyline_mcu_too_wide", 1);
+        return false;
+    }
+    let mut level = vec![mbox.y0; cols];
+    for l in level
+        .iter_mut()
+        .take(col_of(mbox.x1 + IC_GAP_NM).min(cols))
+        .skip(col_of(mbox.x0 - IC_GAP_NM))
+    {
+        *l = mbox.y1 + IC_GAP_NM;
+    }
+    let up = |v: i64| -((-v).div_euclid(SNAP) * SNAP);
+    let mut boxes: Vec<(usize, Vec<usize>, Rect)> = gs
+        .into_iter()
+        .filter_map(|(i, m)| {
+            let b = m.iter().filter_map(|&j| placed[j].as_ref().map(|p| p.keep)).reduce(Rect::union)?;
+            Some((i, m, b))
+        })
+        .collect();
+    boxes.sort_by_key(|(i, _, b)| {
+        (
+            std::cmp::Reverse(b.y1 - b.y0),
+            std::cmp::Reverse(b.x1 - b.x0),
+            rank.map_or(0, |r| r[*i]),
+        )
+    });
+    for (_, members, b) in boxes {
+        let w = usize::try_from(up(b.x1 - b.x0 + IC_GAP_NM) / SNAP + 1).unwrap_or(usize::MAX);
+        if w > cols {
+            stat("skyline_group_too_wide", 1);
+            return false;
+        }
+        let tx = target_x(&members);
+        let half = (b.x1 - b.x0) / 2;
+        let Some((y, _, c)) = (0..=cols - w)
+            .map(|c| {
+                let centre = x0 + i64::try_from(c).unwrap_or(0) * SNAP + half;
+                (level[c..c + w].iter().copied().max().unwrap_or(0), (centre - tx).abs(), c)
+            })
+            .min()
+        else {
+            return false;
+        };
+        let tx = x0 + i64::try_from(c).unwrap_or(0) * SNAP;
+        let d = (up(tx - b.x0), up(y - b.y0));
+        for &m in &members {
+            if let Some(p) = placed[m].as_mut() {
+                shift(p, d);
+            }
+        }
+        let bottom = b.y1 + d.1 + IC_GAP_NM;
+        for l in &mut level[c..c + w] {
+            *l = bottom;
+        }
+    }
+    true
+}
+
+/// The spike's dump: the outline, every placement and pad, and the counters.
+fn spike_dump(items: &[Item<'_>], placed: &[Placed], outline: Rect) {
+    let Ok(path) = std::env::var("AET_1313B_DUMP") else {
+        return;
+    };
+    let r = |b: Rect| format!("[{},{},{},{}]", b.x0, b.y0, b.x1, b.y1);
+    let mut s = format!("{{\"outline\":{},\"parts\":[", r(outline));
+    for (n, (it, p)) in items.iter().zip(placed).enumerate() {
+        if n > 0 {
+            s.push(',');
+        }
+        let pads: Vec<String> = board_pads(it, p)
+            .filter(|(_, net)| real_net(net))
+            .map(|(a, net)| format!("[{},{},\"{}\"]", a.0, a.1, net.replace('"', "'")))
+            .collect();
+        s += &format!(
+            "{{\"ref\":\"{}\",\"lib\":\"{}\",\"fp\":\"{}\",\"at\":[{},{}],\"rot\":{},\"keep\":{},\"court\":{},\"pads\":[{}]}}",
+            p.reference, it.part.lib_id, it.part.footprint, p.origin.0, p.origin.1, p.rotation, r(p.keep), r(p.courtyard), pads.join(",")
+        );
+    }
+    s += "],\"stats\":{";
+    STATS.with(|st| {
+        let v: Vec<String> = st.borrow().iter().map(|(k, n)| format!("\"{k}\":{n}")).collect();
+        s += &v.join(",");
+    });
+    s += "}}";
+    let _ = std::fs::write(path, s);
+}
