+// ===================== SPIKE AET-WO-1313b (never merged) =====================
+
+/// `AET_1313B` holds the method letters: `k` canonical order and a name-free
+/// target (lowest-numbered shared pad), `m` the centroid target instead, `s`
+/// sidestep compaction, `p` skyline repacking, `t` the test-pad rule.
+fn spike(c: char) -> bool {
+    std::env::var("AET_1313B").is_ok_and(|s| s.contains(c))
+}
+
+thread_local! {
+    static STATS: std::cell::RefCell<Vec<(String, i64)>> = const { std::cell::RefCell::new(Vec::new()) };
+}
+
+fn stat(key: &str, by: i64) {
+    STATS.with(|s| {
+        let mut s = s.borrow_mut();
+        if let Some(e) = s.iter_mut().find(|(k, _)| k == key) {
+            e.1 += by;
+        } else {
+            s.push((key.to_owned(), by));
+        }
+    });
+}
+
+const FNV0: u64 = 0xcbf2_9ce4_8422_2325;
+fn fnv(mut h: u64, bytes: &[u8]) -> u64 {
+    for b in bytes {
+        h ^= u64::from(*b);
+        h = h.wrapping_mul(0x0100_0000_01b3);
+    }
+    h
+}
+
+fn real_net(n: &str) -> bool {
+    !n.starts_with("unconnected-")
+}
+
+/// Each item's canonical rank: a total order computed from footprints and
+/// the net graph, with the reference only to break what still ties.
+fn canon_ranks(items: &[Item<'_>]) -> Vec<usize> {
+    let mut nets: BTreeMap<&str, Vec<(usize, &str)>> = BTreeMap::new();
+    for (i, it) in items.iter().enumerate() {
+        for (num, (_, net)) in &it.pads {
+            if real_net(net) {
+                nets.entry(net.as_str()).or_default().push((i, num.as_str()));
+            }
+        }
+    }
+    let base: Vec<u64> = items
+        .iter()
+        .map(|it| fnv(fnv(FNV0, it.part.lib_id.as_bytes()), it.part.footprint.as_bytes()))
+        .collect();
+    let owner_of: Vec<Option<usize>> = items
+        .iter()
+        .map(|it| {
+            let o = it.part.owner.as_ref()?;
+            items.iter().position(|x| x.part.reference == o.ic)
+        })
+        .collect();
+    let mut colour = base.clone();
+    for _ in 0..3 {
+        let mut net_c: BTreeMap<&str, u64> = BTreeMap::new();
+        for (name, pads) in &nets {
+            let mut v: Vec<(u64, &str)> = pads.iter().map(|&(i, n)| (colour[i], n)).collect();
+            v.sort_unstable();
+            let mut h = FNV0;
+            for (c, n) in v {
+                h = fnv(fnv(fnv(h, &c.to_le_bytes()), n.as_bytes()), b"|");
+            }
+            net_c.insert(name, h);
+        }
+        colour = items
+            .iter()
+            .enumerate()
+            .map(|(i, it)| {
+                let mut v: Vec<(&str, u64)> = it
+                    .pads
+                    .iter()
+                    .filter(|(_, (_, n))| real_net(n))
+                    .map(|(num, (_, n))| (num.as_str(), net_c[n.as_str()]))
+                    .collect();
+                v.sort_unstable();
+                let mut h = base[i];
+                for (num, c) in v {
+                    h = fnv(fnv(h, num.as_bytes()), &c.to_le_bytes());
+                }
+                // Ownership: the owner's colour, whether it decouples, and
+                // the anchor's pad pairs (never the owner's name).
+                if let Some(o) = it.part.owner.as_ref() {
+                    if let Some(j) = owner_of[i] {
+                        h = fnv(h, &colour[j].to_le_bytes());
+                    }
+                    h = fnv(h, if o.decouples { b"d" } else { b"-" });
+                    if let Some(a) = o.anchor.as_ref() {
+                        h = fnv(h, &a.seq.to_le_bytes());
+                    }
+                    for (own, theirs) in o.anchor.iter().flat_map(|a| a.pads.iter()) {
+                        h = fnv(fnv(fnv(h, own.as_bytes()), b":"), theirs.as_bytes());
+                    }
+                }
+                h
+            })
+            .collect();
+    }
+    // Net-graph distance to the MCU over label nets (rails and GND reach all).
+    let mcu = items.iter().position(|it| it.part.lib_id.starts_with("MCU_"));
+    let mut dist = vec![usize::MAX; items.len()];
+    if let Some(m) = mcu {
+        dist[m] = 0;
+        let mut frontier = vec![m];
+        let mut d = 0;
+        while !frontier.is_empty() {
+            d += 1;
+            let mut next = Vec::new();
+            for &i in &frontier {
+                for (_, net) in items[i].pads.values() {
+                    if !net.starts_with('/') {
+                        continue;
+                    }
+                    for &(j, _) in &nets[net.as_str()] {
+                        if dist[j] == usize::MAX {
+                            dist[j] = d;
+                            next.push(j);
+                        }
+                    }
+                }
+            }
+            frontier = next;
+        }
+    }
+    let owns = |i: usize| {
+        let r = items[i].part.reference.as_str();
+        items.iter().any(|x| {
+            x.part
+                .owner
+                .as_ref()
+                .is_some_and(|o| o.anchor.is_some() && o.ic == r)
+        })
+    };
+    let gnd_tp = |i: usize| {
+        items[i].part.lib_id == schematic::TEST_POINT
+            && items[i].pads.values().all(|(_, n)| n == GND)
+    };
+    let mut order: Vec<usize> = (0..items.len()).collect();
+    order.sort_by(|&a, &b| {
+        let key = |i: usize| {
+            let p = items[i].part;
+            let c = items[i].geometry.courtyard;
+            (
+                !p.lib_id.starts_with("MCU_"),
+                !is_ic(p),
+                is_bench(p),
+                gnd_tp(i),
+                !owns(i),
+                std::cmp::Reverse(i128::from(c.x1 - c.x0) * i128::from(c.y1 - c.y0)),
+                dist[i],
+                colour[i],
+            )
+        };
+        // SPIKE check: AET_1313B_REVTIE reverses the last tie-break.
+        let tie = items[a].part.reference.cmp(&items[b].part.reference);
+        let tie = if std::env::var("AET_1313B_REVTIE").is_ok() { tie.reverse() } else { tie };
+        key(a).cmp(&key(b)).then(tie)
+    });
+    let mut rank = vec![0; items.len()];
+    for (r, &i) in order.iter().enumerate() {
+        rank[i] = r;
+    }
+    rank
+}
