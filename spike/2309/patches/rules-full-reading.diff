+/// Kind 10's "all read or all unread" across the boot's reads (`AET-WO-3201`
+/// adversarial 5.8): the judge reads every solved register (kind 11) and
+/// every identity read's record (kinds 12 and 21, its value and its status)
+/// in the read that reads the boot, so each is read exactly when the boot
+/// is. A witness's log lines and its attribution evidence (kinds 13 and 22)
+/// are unread when the boot is; a read boot may still hold a witness unread,
+/// when Renode's log passed the filter's budget (`renode.rs`, `AET-WO-2204`
+/// D2).
+fn check_read_with_the_boot(records: &[Record]) -> Result<(), &'static str> {
+    let read = records.iter().any(
+        |r| matches!(r, Record::BootObserved { boot_word, .. } if boot_word.observed.is_some()),
+    );
+    let together = records.iter().all(|r| match r {
+        Record::RegisterObserved { reading, .. } => reading.observed.is_some() == read,
+        Record::I2cCheck {
+            observed, status, ..
+        }
+        | Record::SpiCheck {
+            observed, status, ..
+        } => observed.is_some() == read && status.is_some() == read,
+        Record::I2cWitness {
+            observed, absent, ..
+        } => read || (observed.is_none() && absent.is_empty()),
+        Record::SpiWitness {
+            observed, unrouted, ..
+        } => read || (observed.is_none() && unrouted.is_empty()),
+        _ => true,
+    });
+    if together {
+        Ok(())
+    } else {
+        Err(
+            "the boot's registers, identity reads and witnesses are not all read or all unread with its boot word",
+        )
+    }
+}
