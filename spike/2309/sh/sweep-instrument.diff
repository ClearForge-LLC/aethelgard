@@ -0,0 +1,45 @@
+//! AET-WO-2309 sweep C instrumentation, applied to a scratch copy only (never committed into
+//! `crates/`): with `AET_2309_SWEEP` set to a file, each `replay_dir` and `check_run` call appends
+//! one line, `<what> <sha256 of its input> <outcome>`.
+use std::io::{Read, Write};
+use std::path::Path;
+
+use sha2::{Digest, Sha256};
+
+pub fn log(what: &str, key: &[u8], outcome: &str) {
+    let Some(path) = std::env::var_os("AET_2309_SWEEP") else {
+        return;
+    };
+    let hex: String = Sha256::digest(key).iter().map(|b| format!("{b:02x}")).collect();
+    let line = format!("{what} {hex} {}\n", outcome.replace('\n', " "));
+    if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+        let _ = f.write_all(line.as_bytes());
+    }
+}
+
+/// The run directory's contents: its own file type, then each entry's name, type, length and
+/// the sha256 of its first MiB (a regular file only: a FIFO is never opened).
+pub fn dir_key(dir: &Path) -> Vec<u8> {
+    let mut key = format!("{:?}", std::fs::symlink_metadata(dir).map(|m| m.file_type())).into_bytes();
+    let mut paths: Vec<_> = std::fs::read_dir(dir)
+        .map(|r| r.filter_map(Result::ok).map(|e| e.path()).collect())
+        .unwrap_or_default();
+    paths.sort();
+    for p in paths {
+        key.extend(p.file_name().unwrap_or_default().as_encoded_bytes());
+        key.push(0);
+        match std::fs::symlink_metadata(&p) {
+            Ok(m) if m.is_file() => {
+                key.extend(m.len().to_le_bytes());
+                let mut b = Vec::new();
+                if let Ok(f) = std::fs::File::open(&p) {
+                    let _ = f.take(1 << 20).read_to_end(&mut b);
+                }
+                key.extend(Sha256::digest(&b));
+            }
+            Ok(m) => key.extend(format!("{:?}", m.file_type()).as_bytes()),
+            Err(_) => key.push(b'?'),
+        }
+    }
+    key
+}
