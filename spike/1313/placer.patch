+/// SPIKE (AET-WO-1313, never pushed): the placed keep-out boxes, as JSON.
+fn spike_dump(path: &str, items: &[Item<'_>], placed: &[Placed], outline: Rect, edge: Option<i64>) {
+    let r = |b: Rect| format!("[{},{},{},{}]", b.x0, b.y0, b.x1, b.y1);
+    let mut s = format!(
+        "{{\"outline\":{},\"edge\":{},\"parts\":[",
+        r(outline),
+        edge.map_or("null".into(), |e| e.to_string())
+    );
+    for (n, (it, p)) in items.iter().zip(placed).enumerate() {
+        if n > 0 {
+            s.push(',');
+        }
+        let kind = if schematic::is_connector(it.part) {
+            "connector"
+        } else if is_ic(it.part) {
+            "ic"
+        } else {
+            "passive"
+        };
+        s += &format!(
+            "{{\"ref\":\"{}\",\"kind\":\"{}\",\"lib\":\"{}\",\"keep\":{},\"court\":{},\"rot\":{},\"owner\":\"{}\"}}",
+            p.reference,
+            kind,
+            it.part.lib_id,
+            r(p.keep),
+            r(p.courtyard),
+            p.rotation,
+            it.part.owner.as_ref().map_or("", |o| o.ic.as_str())
+        );
+    }
+    s += "]}";
+    let _ = std::fs::write(path, s);
+}
