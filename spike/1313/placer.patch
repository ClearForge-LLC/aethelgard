+/// SPIKE (a): each non-MCU IC with every part anchored beside it, moved as
+/// one rigid group, a [`STEP`] at a time toward the MCU's centre, x then y,
+/// while every member keeps the gap the placer gave it from every other part
+/// and stays out of the approach strips; in reference order, until no group
+/// moves.
+fn compact(
+    items: &[Item<'_>],
+    placed: &mut [Option<Placed>],
+    anchor_of: &[Option<usize>],
+    rule: &[(Option<i64>, bool, usize)],
+    approach: &[Rect],
+) {
+    let Some(mcu) = placed.iter().flatten().next().map(|p| p.courtyard.centre()) else {
+        return;
+    };
+    let gap = |a: usize, b: usize| -> i64 {
+        let later = if rule[a].2 >= rule[b].2 { a } else { b };
+        match (rule[later].0, rule[a].1 && rule[b].1) {
+            (Some(r), _) => r,
+            (None, true) => IC_GAP_NM,
+            (None, false) => GAP_NM,
+        }
+    };
+    let mut groups: Vec<(String, Vec<usize>)> = (0..items.len())
+        .filter(|&i| {
+            is_ic(items[i].part)
+                && !items[i].part.lib_id.starts_with("MCU_")
+                && !schematic::is_connector(items[i].part)
+                && placed[i].is_some()
+        })
+        .map(|i| {
+            let mut m = vec![i];
+            m.extend((0..items.len()).filter(|&j| anchor_of[j] == Some(i)));
+            (items[i].part.reference.clone(), m)
+        })
+        .collect();
+    groups.sort();
+    for _ in 0..2000 {
+        let mut moved = false;
+        for (_, members) in &groups {
+            let Some(c) = members
+                .iter()
+                .filter_map(|&m| placed[m].as_ref().map(|p| p.keep))
+                .reduce(Rect::union)
+                .map(Rect::centre)
+            else {
+                continue;
+            };
+            for d in [((mcu.0 - c.0).signum() * STEP, 0), (0, (mcu.1 - c.1).signum() * STEP)] {
+                if d == (0, 0) {
+                    continue;
+                }
+                let ok = members.iter().all(|&m| {
+                    let Some(p) = placed[m].as_ref() else { return true };
+                    let k = p.keep.shift(d);
+                    approach.iter().all(|a| !a.overlaps(k))
+                        && (0..items.len()).all(|o| {
+                            members.contains(&o)
+                                || placed[o]
+                                    .as_ref()
+                                    .is_none_or(|q| !q.keep.overlaps(k.grow(gap(m, o))))
+                        })
+                });
+                if ok {
+                    for &m in members {
+                        if let Some(p) = placed[m].as_mut() {
+                            p.origin = (p.origin.0 + d.0, p.origin.1 + d.1);
+                            p.keep = p.keep.shift(d);
+                            p.courtyard = p.courtyard.shift(d);
+                        }
+                    }
+                    moved = true;
+                }
+            }
+        }
+        if !moved {
+            break;
+        }
+    }
+}
