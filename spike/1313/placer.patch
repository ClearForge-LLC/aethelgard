+/// SPIKE (AET-WO-1313): `AET_1313_OPT` holds the options' letters.
+fn spike_opt(c: char) -> bool {
+    std::env::var("AET_1313_OPT").is_ok_and(|s| s.contains(c))
+}
+
+/// SPIKE: which edge each connector goes on, in reference order. `c`: the
+/// left and right edges, each connector to the side with less length so far
+/// (ties left); `C`: bottom and top, the same way (ties bottom); otherwise
+/// the bottom. Rotation: cable side out (0 bottom, 90 right, 180 top, 270 left).
+fn spike_sides(items: &[Item<'_>]) -> Vec<(usize, u16)> {
+    let mut row: Vec<usize> = (0..items.len())
+        .filter(|&i| schematic::is_connector(items[i].part))
+        .collect();
+    row.sort_by(|&a, &b| items[a].part.reference.cmp(&items[b].part.reference));
+    let pair = if spike_opt('c') {
+        Some((270u16, 90u16))
+    } else if spike_opt('C') {
+        Some((0, 180))
+    } else {
+        None
+    };
+    let Some((first, second)) = pair else {
+        return row.into_iter().map(|i| (i, 0)).collect();
+    };
+    let (mut l1, mut l2) = (0i64, 0i64);
+    row.into_iter()
+        .map(|i| {
+            let k = items[i].geometry.keep;
+            let w = k.x1 - k.x0 + IC_GAP_NM;
+            if l1 <= l2 {
+                l1 += w;
+                (i, first)
+            } else {
+                l2 += w;
+                (i, second)
+            }
+        })
+        .collect()
+}
+
+/// SPIKE: the core's largest width and height inside `AET_1313_BOUND`
+/// ("W,H" in mm), less each used edge's connector band and the margins.
+fn spike_limits(items: &[Item<'_>]) -> Option<(i64, i64)> {
+    let s = std::env::var("AET_1313_BOUND").ok()?;
+    let (w, h) = s.split_once(',')?;
+    let (w, h): (f64, f64) = (w.parse().ok()?, h.parse().ok()?);
+    #[allow(clippy::cast_possible_truncation)]
+    let (mut wc, mut hc) = ((w * 1e6) as i64, (h * 1e6) as i64);
+    let sides = spike_sides(items);
+    for rot in [0u16, 90, 180, 270] {
+        let band = sides
+            .iter()
+            .filter(|&&(_, r)| r == rot)
+            .map(|&(i, _)| {
+                let g = items[i].geometry;
+                g.courtyard.y1 - g.keep.y0 + IC_GAP_NM
+            })
+            .max();
+        match (rot, band) {
+            (0 | 180, Some(b)) => hc -= b,
+            (_, Some(b)) => wc -= b,
+            (0 | 180, None) => hc -= MARGIN_NM,
+            (_, None) => wc -= MARGIN_NM,
+        }
+    }
+    // The outline snaps outward by up to one SNAP on each side.
+    Some((wc - 2 * SNAP, hc - 2 * SNAP))
+}
+
+/// SPIKE (b): every free candidate from the first free ring out to
+/// `WINDOW` rings beyond it, scored by how far the core's box would overflow
+/// `limits`, then the box's area, then the ring order; past the window, the
+/// first candidate that does not overflow, up to `REACH` rings.
+fn spot_bounded(
+    g: Geometry,
+    target: (i64, i64),
+    taken: &[(Rect, i64)],
+    core: Option<Rect>,
+    limits: Option<(i64, i64)>,
+) -> Option<(i64, i64)> {
+    const WINDOW: i64 = 40;
+    const REACH: i64 = 400;
+    let (cx, cy) = g.keep.centre();
+    let snap = |v: i64| v.div_euclid(SNAP) * SNAP;
+    let score = |keep: Rect| -> (i64, i128) {
+        let b = core.map_or(keep, |c| c.union(keep));
+        let (w, h) = (b.x1 - b.x0, b.y1 - b.y0);
+        let over = limits.map_or(0, |(lw, lh)| (w - lw).max(0) + (h - lh).max(0));
+        // `B`: overflow only, so the ring order decides among the rest (the
+        // first free spot that keeps the core inside the bound).
+        let area = if spike_opt('B') { 0 } else { i128::from(w) * i128::from(h) };
+        (over, area)
+    };
+    let mut best: Option<((i64, i128), (i64, i64))> = None;
+    let mut first: Option<i64> = None;
+    for r in 0..=REACH {
+        if let Some(f) = first
+            && r > f + WINDOW
+            && best.is_some_and(|(s, _)| s.0 == 0)
+        {
+            break;
+        }
+        let mut ring: Vec<(i64, i64)> = Vec::new();
+        for d in -r..=r {
+            ring.extend([(d, -r), (d, r)]);
+            if d != -r && d != r {
+                ring.extend([(-r, d), (r, d)]);
+            }
+        }
+        ring.sort_by_key(|&(dx, dy)| (dx * dx + dy * dy, dy, dx));
+        ring.dedup();
+        for (dx, dy) in ring {
+            let origin = (
+                snap(target.0 + dx * STEP - cx),
+                snap(target.1 + dy * STEP - cy),
+            );
+            let keep = g.keep.shift(origin);
+            if !taken.iter().all(|&(t, gap)| !t.overlaps(keep.grow(gap))) {
+                continue;
+            }
+            first.get_or_insert(r);
+            let s = score(keep);
+            if first.is_some_and(|f| r > f + WINDOW) && s.0 > 0 {
+                continue;
+            }
+            if best.is_none_or(|(b, _)| s < b) {
+                best = Some((s, origin));
+            }
+        }
+    }
+    best.map(|(_, o)| o)
+}
